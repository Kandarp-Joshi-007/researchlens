# Copy to .env and adjust. Every setting is optional — the defaults suit a
# local install with Ollama on the same machine.
#
# Loaded by backend/__init__.py and frontend/app.py at import time, so a change
# here needs a restart to take effect.

# --- Model ---------------------------------------------------------------
# RESEARCHLENS_MODEL=qwen2.5:7b
# RESEARCHLENS_EMBED_MODEL=nomic-embed-text
# OLLAMA_HOST=http://localhost:11434

# Context window per request. Ollama defaults to 2048 regardless of what the
# model supports, which silently truncates long prompts. 8192 suits a 4 GB
# card; raise it if you have more VRAM.
# RESEARCHLENS_NUM_CTX=8192

# --- Analysis ------------------------------------------------------------
# Samples per agent when deep analysis is requested.
# RESEARCHLENS_DEEP_SAMPLES=3

# Seconds without progress before a run is reported as stale.
# RESEARCHLENS_STALE_RUN_SECONDS=900

# Analyses accepted at once. One runs; the rest queue. Each waiting analysis
# occupies a threadpool worker that the API endpoints also draw on, so raising
# this too far makes the UI unresponsive during a bulk upload. Past the cap an
# upload is refused with 429.
# RESEARCHLENS_MAX_IN_FLIGHT=6

# --- Uploads -------------------------------------------------------------
# RESEARCHLENS_MAX_UPLOAD_MB=50

# --- Logging -------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR. INFO shows per-agent progress during a run.
# RESEARCHLENS_LOG_LEVEL=INFO

# --- Prior art (OpenAlex) ------------------------------------------------
# Set to 0 to disable outbound lookups entirely and stay fully offline.
# RESEARCHLENS_PRIOR_ART=1
# Supplying a contact email joins OpenAlex's polite pool (faster, more reliable).
# RESEARCHLENS_CONTACT_EMAIL=you@example.com
# RESEARCHLENS_HTTP_TIMEOUT=12

# --- API -----------------------------------------------------------------
# Comma-separated origins allowed to call the backend.
# RESEARCHLENS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Where the frontend looks for the backend. Set this if you move the API off
# :8000 — BACKEND_PORT in run.sh is honoured too.
# RESEARCHLENS_API_BASE=http://localhost:8000
